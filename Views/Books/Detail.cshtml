@model QuanLySach.Models.Book

@{
    ViewData["Title"] = Model.Title;
}

<div class="detail-page container" style="padding: 20px;">

    <!-- BREADCRUMB -->
    <nav class="breadcrumb" style="font-size:13px; color:#999; margin-bottom:24px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
        <a asp-controller="Home" asp-action="Index" style="color:#b8860b;">Главная</a> ›
        <a asp-controller="Books" asp-action="Index" style="color:#b8860b;">Все книги</a> ›
        <a asp-controller="Books" asp-action="Index" asp-route-categoryId="@Model.CategoryId" style="color:#b8860b;">@Model.Category?.Name</a> ›
        <span>@Model.Title</span>
    </nav>

    <!-- MAIN INFO -->
    <div class="book-detail-layout">

        <!-- ẢNH -->
        <div class="book-detail-cover">
            <img src="@Model.CoverImageUrl" alt="@Model.Title"
                 onerror="this.src='https://via.placeholder.com/300x420?text=No+Cover'" />
        </div>

        <!-- THÔNG TIN -->
        <div class="book-detail-info">
            <span class="book-detail-category">@Model.Category?.Name</span>

            <h1 class="book-detail-title">@Model.Title</h1>

            <div class="book-detail-description">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p>@Model.Description</p>
                }
                else
                {
                    <p style="color:#999">Описание пока не добавлено.</p>
                }
            </div>

            <p class="book-detail-author"><i class="fas fa-user-edit"></i> @Model.Author</p>

            @if (Model.IsPopular)
            {
                <span class="book-detail-badge">⭐ Популярная книга</span>
            }

            <div class="book-detail-meta">
                <div class="meta-row">
                    <span class="meta-label">Категория</span>
                    <span>@Model.Category?.Name</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Автор</span>
                    <span>@Model.Author</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Статус</span>
                    @if (Model.Stock > 0)
                    {
                        <span style="color:#2e7d32; font-weight:600;">✓ В наличии (@Model.Stock шт.)</span>
                    }
                    else
                    {
                        <span style="color:#c0392b; font-weight:600;">✗ Нет в наличии</span>
                    }
                </div>
            </div>

            <div class="book-detail-price">@Model.Price.ToString("0.00") ₽</div>

            <div class="book-detail-actions">
                @if (Model.Stock > 0)
                {
                    <button class="btn-cart-detail" onclick="addToCart(@Model.Id)">
                        <i class="fas fa-shopping-cart"></i> В корзину
                    </button>
                }
                else
                {
                    <button class="btn-cart-detail" disabled style="opacity:0.5; cursor:not-allowed;">
                        <i class="fas fa-ban"></i> Нет в наличии
                    </button>
                }
                <button class="wishlist-btn-detail @(ViewBag.IsWishlisted ? "active" : "")"
                        onclick="toggleWishlist(@Model.Id, this)">
                    <i class="fas fa-heart"></i>
                    <span>@(ViewBag.IsWishlisted ? "В избранном" : "В избранное")</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ПОХОЖИЕ КНИГИ -->
    @if (ViewBag.RelatedBooks != null && ((List<QuanLySach.Models.Book>)ViewBag.RelatedBooks).Any())
    {
        <div class="related-section">
            <h2 class="related-title">Похожие книги</h2>
            <div class="books-grid">
                @foreach (var book in (List<QuanLySach.Models.Book>)ViewBag.RelatedBooks)
                {
                    <div class="book-card">
                        <a asp-action="Detail" asp-route-id="@book.Id" style="text-decoration:none; color:inherit;">
                            <div class="book-cover">
                                <img src="@book.CoverImageUrl" alt="@book.Title"
                                     onerror="this.src='https://via.placeholder.com/200x300?text=No+Cover'" />
                            </div>
                            <div class="book-info">
                                <h4>@book.Title</h4>
                                <p class="author">@book.Author</p>
                                <p class="price">@book.Price.ToString("0.00") ₽</p>
                            </div>
                        </a>
                        <div style="padding: 0 14px 14px">
                            @if (book.Stock > 0)
                            {
                                <button class="btn-cart" onclick="addToCart(@book.Id)">
                                    <i class="fas fa-shopping-cart"></i> В корзину
                                </button>
                            }
                            else
                            {
                                <button class="btn-cart" disabled style="opacity:0.5; cursor:not-allowed;">
                                    <i class="fas fa-ban"></i> Нет в наличии
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .book-detail-layout {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 40px;
        margin-bottom: 40px;
        background: #fff;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }

    .book-detail-cover {
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

        .book-detail-cover img {
            width: 100%;
            max-width: 260px;
            border-radius: 8px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        }

    .book-detail-category {
        background: #f5e6c8;
        color: #b8860b;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        display: inline-block;
    }

    .book-detail-title {
        font-family: 'Playfair Display', serif;
        font-size: 28px;
        color: #2c1a0e;
        margin: 12px 0 16px;
        line-height: 1.2;
    }

    .book-detail-description {
        margin-bottom: 16px;
    }

        .book-detail-description p {
            font-size: 15px;
            color: #555;
            line-height: 1.7;
        }

    .book-detail-author {
        font-size: 15px;
        color: #666;
        margin-bottom: 12px;
    }

        .book-detail-author i {
            color: #b8860b;
            margin-right: 6px;
        }

    .book-detail-badge {
        display: inline-block;
        background: #fff8e1;
        color: #f57f17;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 16px;
    }

    .book-detail-meta {
        border-top: 1px solid #f0e8d8;
        border-bottom: 1px solid #f0e8d8;
        padding: 8px 0;
        margin-bottom: 20px;
        margin-top: 12px;
    }

    .meta-row {
        display: flex;
        gap: 16px;
        padding: 8px 0;
        border-bottom: 1px solid #f9f4ec;
        font-size: 14px;
    }

        .meta-row:last-child {
            border-bottom: none;
        }

    .meta-label {
        color: #999;
        min-width: 90px;
        flex-shrink: 0;
    }

    .book-detail-price {
        font-size: 32px;
        font-weight: 700;
        color: #b8860b;
        margin-bottom: 20px;
    }

    .book-detail-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-cart-detail {
        background: #b8860b;
        color: #fff;
        border: none;
        padding: 14px 28px;
        border-radius: 6px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
        flex: 1;
        min-width: 140px;
    }

        .btn-cart-detail:hover {
            background: #8b6508;
        }

    .wishlist-btn-detail {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #fff;
        border: 2px solid #ddd;
        padding: 14px 20px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        color: #666;
        transition: all 0.2s;
        flex: 1;
        min-width: 140px;
    }

        .wishlist-btn-detail:hover,
        .wishlist-btn-detail.active {
            border-color: #e53935;
            color: #e53935;
        }

            .wishlist-btn-detail.active i {
                color: #e53935;
            }

    .related-section {
        margin-top: 20px;
    }

    .related-title {
        font-family: 'Playfair Display', serif;
        font-size: 24px;
        color: #b8860b;
        margin-bottom: 24px;
    }

    /* ===== MOBILE ===== */
    @@media (max-width: 768px) {
        .detail-page.container {
            padding: 12px !important;
        }

        .book-detail-layout {
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 16px;
        }

        .book-detail-cover img {
            max-width: 160px;
            margin: 0 auto;
            display: block;
        }

        .book-detail-title {
            font-size: 20px;
        }

        .book-detail-price {
            font-size: 26px;
            margin-bottom: 16px;
        }

        .book-detail-actions {
            flex-direction: column;
            gap: 10px;
        }

        .btn-cart-detail,
        .wishlist-btn-detail {
            width: 100%;
            padding: 12px;
            font-size: 14px;
        }

        .meta-label {
            min-width: 80px;
        }

        .meta-row {
            font-size: 13px;
        }

        .related-title {
            font-size: 18px;
        }

        .books-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 10px;
        }
    }
</style>

<script>
    function toggleWishlist(bookId, btn) {
        fetch('/Account/ToggleWishlist', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ bookId: bookId })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                if (data.added) {
                    btn.classList.add('active');
                    btn.querySelector('i').style.color = '#e53935';
                    btn.querySelector('span').textContent = 'В избранном';
                } else {
                    btn.classList.remove('active');
                    btn.querySelector('i').style.color = '';
                    btn.querySelector('span').textContent = 'В избранное';
                }
            } else {
                alert(data.message || 'Войдите в аккаунт');
            }
        });
    }
</script>