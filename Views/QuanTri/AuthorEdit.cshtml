@using QuanLySach.Models
@model Author
@{
    Layout = "_QuanTriLayout";
    ViewBag.Title = "Редактировать автора";
}

<div class="admin-panel">
    <form asp-action="AuthorEdit" asp-route-id="@Model.Id" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label>Имя автора</label>
            <input type="text" asp-for="Name" required />
        </div>
        <div class="form-group">
            <label>Биография</label>
            <textarea asp-for="Bio" rows="4"></textarea>
        </div>
        <div class="form-group">
            <label>Ссылка на фото (необязательно)</label>
            <input type="text" asp-for="PhotoUrl" />
        </div>
        <button type="submit" class="btn btn-gold">Обновить</button>
        <a asp-action="Authors" class="btn btn-outline">Отмена</a>
    </form>
</div>