@using QuanLySach.Models
@model List<ContactMessage>
@{
    Layout = "_QuanTriLayout";
    ViewBag.Title = "Сообщения от клиентов";
}

<div class="admin-panel">
    <div class="panel-header">
        <h2>Tin nhắn liên hệ (@Model.Count)</h2>
    </div>

    @if (!Model.Any())
    {
        <p style="padding:20px; color:#999;">Chưa có tin nhắn nào.</p>
    }
    else
    {
        @foreach (var m in Model)
        {
            <div class="admin-panel" style="margin-bottom:16px; border-left:4px solid @(m.AdminReply != null ? "#2e7d32" : "#b8860b");">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px;">
                    <div>
                        <strong>@m.Name</strong> — <span style="color:#888;">@m.Email</span>
                        <div style="font-size:12px; color:#aaa; margin-top:4px;">@m.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div style="display:flex; align-items:center; gap:10px;">
                        @if (m.AdminReply != null)
                        {
                            <span class="badge" style="background:#e8f5e9; color:#2e7d32;">Đã trả lời</span>
                        }
                        else
                        {
                            <span class="badge" style="background:#fff3e0; color:#b8860b;">Chưa trả lời</span>
                        }
                        <form asp-action="MessageDelete" asp-route-id="@m.Id" method="post"
                              onsubmit="return confirm('Xóa tin nhắn này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline btn-sm">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>

                <p style="margin:14px 0; padding:12px 16px; background:#fafafa; border-radius:6px;">@m.Message</p>

                @if (m.AdminReply != null)
                {
                    <div style="padding:12px 16px; background:#fff8e6; border-left:3px solid #b8860b; border-radius:6px; margin-bottom:10px;">
                        <strong style="color:#b8860b; font-size:13px;">
                            <i class="fas fa-reply"></i> Đã trả lời lúc @m.RepliedAt?.ToString("dd/MM/yyyy HH:mm")
                        </strong>
                        <p style="margin:6px 0 0;">@m.AdminReply</p>
                    </div>
                }

                <form asp-action="MessageReply" asp-route-id="@m.Id" method="post" class="admin-form" style="margin-top:10px;">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <textarea name="reply" rows="2" placeholder="Nhập nội dung trả lời khách hàng..." required>@m.AdminReply</textarea>
                    </div>
                    <button type="submit" class="btn btn-gold btn-sm">
                        @(m.AdminReply != null ? "Cập nhật trả lời" : "Gửi trả lời")
                    </button>
                </form>
            </div>
        }
    }
</div>
