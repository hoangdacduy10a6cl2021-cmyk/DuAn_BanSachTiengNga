@{
    ViewData["Title"] = "Забыли пароль";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["HideFooter"] = true;
}

<div class="reg-page">
    <div class="reg-wrap" style="max-width:560px;">
        <div class="reg-form-side" style="padding:52px 48px;">

            <h1 class="reg-title">Забыли пароль?</h1>
            <p class="reg-subtitle">Введите e-mail — мы сбросим пароль</p>

            @if (ViewBag.Error != null)
            {
                <div style="background:#fff0f0; border:1px solid #f5c6c6; border-radius:8px;
                    padding:10px 14px; font-size:13px; color:#c0392b; margin-bottom:18px;">
                    @ViewBag.Error
                </div>
            }

            <form asp-action="ForgotPassword" asp-controller="Account" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="reg-group">
                    <label class="reg-label" for="email">E-mail</label>
                    <input class="reg-input"
                           type="email"
                           id="email"
                           name="email"
                           placeholder="Введите ваш e-mail"
                           autocomplete="email" />
                </div>

                <button type="submit" class="reg-btn">Сбросить пароль</button>

                <p class="reg-login-row">
                    Вспомнили пароль?&nbsp;
                    <a asp-action="Login" asp-controller="Account">Войти</a>
                </p>
            </form>
        </div>
    </div>
</div>

@* Dùng lại CSS từ Login.cshtml — cần thêm các class reg-* *@
<style>
