@model List<QuanLySach.Models.PaymentCard>

@{
    ViewData["Title"] = "Способы оплаты";
    ViewData["ActiveMenu"] = "Payment";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="profile-page">
    <div class="container">
        <div class="profile-layout">
            <partial name="_ProfileSidebar" />

            <div class="profile-content">
                <h2>Мои способы оплаты</h2>

                @if (TempData["CardSuccess"] != null)
                {
                    <div class="alert-success">✓ @TempData["CardSuccess"]</div>
                }

                <div class="payment-section">
                    <h3>Способы оплаты</h3>

                    <!-- VIETCOMBANK -->
                    <div class="payment-method-item" onclick="toggleQR('vcb')" style="cursor:pointer">
                        <div class="payment-method-logo vcb"><span>VCB</span></div>
                        <span>Vietcombank — 1035382800</span>
                        <i class="fas fa-qrcode payment-qr-icon"></i>
                    </div>
                    <div id="qr-vcb" class="qr-inline" style="display:none">
                        <div class="qr-inline-box">
                            <div class="qr-bank-header vcb"><i class="fas fa-bank"></i> Ngân hàng Vietcombank</div>
                            <img src="https://img.vietqr.io/image/vietcombank-1035382800-compact2.jpg"
                                 alt="QR Vietcombank" class="qr-inline-img" />
                            <div class="qr-info">
                                <div class="qr-info-row"><span>Счёт:</span><strong>1035382800</strong></div>
                                <div class="qr-info-row"><span>Владелец:</span><strong>PHAM DUC HOA</strong></div>
                            </div>
                            <p class="qr-note">Откройте приложение банка и отсканируйте QR-код</p>
                        </div>
                    </div>

                    <!-- ZALOPAY -->
                    <div class="payment-method-item" onclick="toggleQR('zalo')" style="cursor:pointer">
                        <div class="payment-method-logo zalopay"><span>ZaloPay</span></div>
                        <span>Кошелёк ZaloPay — PHAM DUC HOA</span>
                        <i class="fas fa-qrcode payment-qr-icon"></i>
                    </div>
                    <div id="qr-zalo" class="qr-inline" style="display:none">
                        <div class="qr-inline-box">
                            <div class="qr-bank-header zalopay"><i class="fas fa-wallet"></i> ZaloPay</div>
                            <img src="/images/zalopay-qr.png"
                                 alt="QR ZaloPay" class="qr-inline-img" />
                            <div class="qr-info">
                                <div class="qr-info-row"><span>Владелец:</span><strong>PHAM DUC HOA</strong></div>
                            </div>
                            <p class="qr-note">Откройте ZaloPay и отсканируйте QR-код</p>
                        </div>
                    </div>

                    <!-- COD - THANH TOÁN TRỰC TIẾP -->
                    <div class="payment-method-item" onclick="toggleQR('cod')" style="cursor:pointer">
                        <div class="payment-method-logo cod"><span>COD</span></div>
                        <span>Наличными при получении</span>
                        <i class="fas fa-chevron-down payment-qr-icon" id="chevron-cod"></i>
                    </div>
                    <div id="qr-cod" class="qr-inline" style="display:none">
                        <div class="qr-inline-box cod-box">

                            <!-- Header -->
                            <div class="cod-header">
                                <div class="cod-icon-circle">
                                    <i class="fas fa-money-bill-wave"></i>
                                </div>
                                <div>
                                    <div class="cod-title">Оплата при получении</div>
                                    <div class="cod-subtitle">Без предоплаты — платите только при получении</div>
                                </div>
                            </div>

                            <!-- Các bước -->
                            <div class="cod-steps">
                                <div class="cod-step">
                                    <span class="cod-step-num">1</span>
                                    <div class="cod-step-text">
                                        <strong>Оформите заказ</strong>
                                        <span>Выберите книги и укажите адрес доставки</span>
                                    </div>
                                </div>
                                <div class="cod-step">
                                    <span class="cod-step-num">2</span>
                                    <div class="cod-step-text">
                                        <strong>Подтверждение магазина</strong>
                                        <span>Мы свяжемся с вами для подтверждения</span>
                                    </div>
                                </div>
                                <div class="cod-step">
                                    <span class="cod-step-num">3</span>
                                    <div class="cod-step-text">
                                        <strong>Ожидайте курьера</strong>
                                        <span>Курьер свяжется с вами перед приездом</span>
                                    </div>
                                </div>
                                <div class="cod-step">
                                    <span class="cod-step-num">4</span>
                                    <div class="cod-step-text">
                                        <strong>Проверьте и оплатите</strong>
                                        <span>Осмотрите заказ и передайте деньги курьеру</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Ghi chú -->
                            <div class="cod-note">
                                <i class="fas fa-info-circle"></i>
                                <span>Доставка по всей стране. Может взиматься дополнительная плата.</span>
                            </div>

                            <span class="cod-badge-free">✓ Бесплатно</span>
                        </div>
                    </div>

                    @{
                        var bankQrCodes = new Dictionary<string, string>
                        {
                            { "Vietcombank", "vietcombank" },
                            { "Techcombank", "techcombank" },
                            { "MB Bank", "mbbank" }
                        };
                    }

                    <!-- CÁC NGÂN HÀNG / VÍ NGƯỜI DÙNG TỰ THÊM -->
                    @foreach (var card in Model)
                    {
                        var boxId = "custom" + card.Id;
                        var hasQr = bankQrCodes.ContainsKey(card.CardType);
                        <div class="payment-method-item" onclick="toggleMethod('@boxId')" style="cursor:pointer">
                            <div class="payment-method-logo custom-card"><i class="fas fa-university"></i></div>
                            <span>@card.CardType — @card.CardNumber</span>
                            <i class="fas fa-qrcode payment-qr-icon" id="chevron-@boxId"></i>
                        </div>
                        <div id="qr-@boxId" class="qr-inline" style="display:none">
                            <div class="qr-inline-box">
                                <div class="qr-bank-header custom"><i class="fas fa-university"></i> @card.CardType</div>
                                @if (hasQr)
                                {
                                    <img src="https://img.vietqr.io/image/@(bankQrCodes[card.CardType])-@(card.CardNumber)-compact2.jpg"
                                         alt="QR @card.CardType" class="qr-inline-img" />
                                }
                                else
                                {
                                    <div class="qr-inline-img qr-placeholder">
                                        <i class="fas fa-qrcode"></i>
                                    </div>
                                }
                                <div class="qr-info">
                                    <div class="qr-info-row"><span>Счёт:</span><strong>@card.CardNumber</strong></div>
                                    <div class="qr-info-row"><span>Владелец:</span><strong>@card.CardName</strong></div>
                                </div>
                                <p class="qr-note">
                                    @(hasQr ? "Откройте приложение банка и отсканируйте QR-код" : "Откройте приложение и отсканируйте QR-код")
                                </p>
                                <form asp-controller="Account" asp-action="RemoveCard" method="post" class="remove-card-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@card.Id" />
                                    <button type="submit" class="remove-card-btn-full">
                                        <i class="fas fa-trash"></i> Удалить
                                    </button>
                                </form>
                            </div>
                        </div>
                    }

                    <!-- NÚT THÊM NGÂN HÀNG MỚI -->
                    <div class="payment-method-item add-bank-item" onclick="openAddBankModal()">
                        <div class="payment-method-logo add-bank-logo"><i class="fas fa-plus"></i></div>
                        <span>Добавить способ оплаты</span>
                        <i class="fas fa-chevron-right payment-qr-icon"></i>
                    </div>

                </div>
            </div>

            <!-- MODAL THÊM NGÂN HÀNG -->
            <div id="addBankModalOverlay" class="add-bank-overlay" style="display:none" onclick="closeAddBankModal(event)">
                <div class="add-bank-modal" onclick="event.stopPropagation()">
                    <div class="add-bank-modal-header">
                        <h3><i class="fas fa-university"></i> Добавить способ оплаты</h3>
                        <button type="button" class="add-bank-close" onclick="closeAddBankModal()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>

                    <form asp-controller="Account" asp-action="AddBankCard" method="post" class="add-bank-form">
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label>Ngân hàng / Ví điện tử</label>
                            <select name="CardType" class="form-control" required>
                                <option value="">-- Chọn ngân hàng --</option>
                                <option value="Vietcombank">Vietcombank</option>
                                <option value="ZaloPay">ZaloPay</option>
                                <option value="Techcombank">Techcombank</option>
                                <option value="MB Bank">MB Bank</option>
                                <option value="Momo">Momo</option>
                                <option value="Khac">Ngân hàng khác</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Số tài khoản</label>
                            <input type="text" name="CardNumber" class="form-control" placeholder="Nhập số tài khoản" required />
                        </div>

                        <div class="form-group">
                            <label>Tên chủ tài khoản</label>
                            <input type="text" name="CardName" class="form-control" placeholder="VD: PHAM DUC HOA" required />
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn-cancel" onclick="closeAddBankModal()">Hủy</button>
                            <button type="submit" class="btn-save"><i class="fas fa-check"></i> Lưu</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .payment-section {
        margin-bottom: 30px;
    }

    .qr-bank-header i {
        margin-right: 8px;
        color: #1F3061;
    }

    .payment-section h3 {
        font-family: Georgia, serif;
        color: #4a2c00;
        font-size: 1rem;
        margin-bottom: 16px;
        border-bottom: 1px solid #f0e8d8;
        padding-bottom: 10px;
    }

    .payment-method-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 16px;
        border: 1.5px solid #f0e8d8;
        border-radius: 8px;
        margin-bottom: 8px;
        transition: all 0.2s;
        background: #fff;
    }

        .payment-method-item:hover {
            border-color: #b8860b;
            background: #fdf6e3;
        }

        .payment-method-item.active {
            border-color: #b8860b;
            background: #fdf6e3;
        }

    .payment-method-logo {
        width: 56px;
        height: 36px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 12px;
        color: #fff;
        flex-shrink: 0;
    }

        .payment-method-logo.vcb {
            background: #006d3c;
        }

        .payment-method-logo.zalopay {
            background: #0068ff;
        }

        .payment-method-logo.cod {
            background: #7c4f00;
        }

    .payment-qr-icon {
        margin-left: auto;
        color: #b8860b;
        font-size: 18px;
        transition: transform 0.25s;
    }

        .payment-qr-icon.open {
            transform: rotate(180deg);
        }

    /* QR INLINE */
    .qr-inline {
        margin-bottom: 12px;
    }

    .qr-inline-box {
        background: #fdf6e3;
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        border: 1.5px solid #f0e8d8;
    }

    .qr-bank-header {
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 16px;
        display: inline-block;
    }

        .qr-bank-header.vcb {
            background: #e8f5e9;
            color: #1b5e20;
        }

        .qr-bank-header.zalo {
            background: #e3f2fd;
            color: #0d47a1;
        }

    .qr-inline-img {
        width: 200px;
        height: 200px;
        object-fit: contain;
        border-radius: 8px;
        border: 2px solid #f0e8d8;
        margin-bottom: 16px;
        display: block;
        margin-left: auto;
        margin-right: auto;
    }

    .qr-info {
        background: #fff;
        border-radius: 8px;
        padding: 12px 16px;
        text-align: left;
        margin-bottom: 12px;
    }

    .qr-info-row {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        padding: 4px 0;
        color: #555;
        border-bottom: 1px solid #f9f4ec;
    }

    .qr-note {
        font-size: 13px;
        color: #888;
    }

    /* ===== COD BOX ===== */
    .cod-box {
        text-align: left;
    }

    .cod-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 16px;
    }

    .cod-icon-circle {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #fff;
        border: 2px solid #ddc590;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .cod-icon-circle i {
            font-size: 22px;
            color: #b8860b;
        }

    .cod-title {
        font-size: 15px;
        font-weight: 700;
        color: #4a2c00;
        margin-bottom: 3px;
    }

    .cod-subtitle {
        font-size: 12px;
        color: #888;
    }

    .cod-steps {
        display: flex;
        flex-direction: column;
        gap: 12px;
        border-top: 1px solid #ddc590;
        padding-top: 16px;
        margin-bottom: 16px;
    }

    .cod-step {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .cod-step-num {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #b8860b;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 13px;
        flex-shrink: 0;
    }

    .cod-step-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding-top: 3px;
    }

        .cod-step-text strong {
            font-size: 13px;
            color: #333;
        }

        .cod-step-text span {
            font-size: 12px;
            color: #888;
        }

    .cod-note {
        background: #fff;
        border: 1px solid #ddc590;
        border-radius: 7px;
        padding: 10px 14px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 12px;
        color: #777;
        line-height: 1.5;
        margin-bottom: 14px;
    }

        .cod-note i {
            color: #b8860b;
            font-size: 15px;
            flex-shrink: 0;
            margin-top: 1px;
        }

    .cod-badge-free {
        display: inline-block;
        background: #e8f5e9;
        color: #2e7d32;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    /* THẺ NGƯỜI DÙNG TỰ THÊM (QR STYLE) */
    .custom-card {
        background: #b8860b;
    }

    .qr-bank-header.custom {
        background: #fdf1d8;
        color: #4a2c00;
    }

    .qr-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        color: #b8860b;
        font-size: 64px;
    }

    .remove-card-form {
        margin-top: 8px;
    }

    .remove-card-btn-full {
        width: 100%;
        background: #fff;
        border: 1px solid #e0b0a8;
        color: #c0392b;
        padding: 8px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
    }

        .remove-card-btn-full:hover {
            background: #fdf0ee;
        }

    /* NÚT THÊM NGÂN HÀNG */
    .add-bank-item {
        border-style: dashed;
        border-color: #b8860b;
        color: #b8860b;
        font-weight: 600;
    }

    .add-bank-logo {
        background: #fdf6e3;
        border: 2px dashed #b8860b;
        color: #b8860b !important;
    }

    /* MODAL */
    .add-bank-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .add-bank-modal {
        background: #fff;
        border-radius: 12px;
        width: 90%;
        max-width: 420px;
        padding: 24px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        animation: fadeInUp .2s ease;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .add-bank-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
        border-bottom: 1px solid #f0e8d8;
        padding-bottom: 12px;
    }

        .add-bank-modal-header h3 {
            font-family: Georgia, serif;
            color: #4a2c00;
            font-size: 1.05rem;
            margin: 0;
        }

    .add-bank-close {
        background: none;
        border: none;
        font-size: 16px;
        color: #999;
        cursor: pointer;
    }

    .add-bank-form .form-group {
        margin-bottom: 14px;
    }

    .add-bank-form label {
        display: block;
        font-size: 13px;
        color: #555;
        margin-bottom: 6px;
        font-weight: 600;
    }

    .add-bank-form .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1.5px solid #f0e8d8;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        transition: border-color .2s;
    }

        .add-bank-form .form-control:focus {
            border-color: #b8860b;
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 18px;
    }

    .btn-cancel {
        padding: 9px 16px;
        border-radius: 8px;
        border: 1.5px solid #f0e8d8;
        background: #fff;
        color: #666;
        cursor: pointer;
    }

    .btn-save {
        padding: 9px 18px;
        border-radius: 8px;
        border: none;
        background: #b8860b;
        color: #fff;
        cursor: pointer;
        font-weight: 600;
    }

        .btn-save:hover {
            background: #9c7209;
        }
</style>

<script>
    function toggleMethod(key) {
        const boxes = document.querySelectorAll('.qr-inline');
        boxes.forEach(function(box) {
            const chevron = document.getElementById('chevron-' + box.id.replace('qr-', ''));
            if (box.id === 'qr-' + key) {
                const isOpen = box.style.display !== 'none';
                box.style.display = isOpen ? 'none' : 'block';
                if (chevron) chevron.classList.toggle('open', !isOpen);
            } else {
                box.style.display = 'none';
                if (chevron) chevron.classList.remove('open');
            }
        });
    }

    function toggleQR(type) {
        toggleMethod(type);
    }

    function openAddBankModal() {
        document.getElementById('addBankModalOverlay').style.display = 'flex';
    }

    function closeAddBankModal(e) {
        document.getElementById('addBankModalOverlay').style.display = 'none';
    }
</script>
