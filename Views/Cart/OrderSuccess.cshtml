@model QuanLySach.Models.Order
@{
    ViewData["Title"] = "Заказ принят";
}

<div class="success-page">
    <div class="success-icon">✓</div>
    <h2>Спасибо за ваш заказ!</h2>
    <p class="success-num">Ваш заказ №@Model.Id принят.</p>
    <p class="success-email">Мы отправили подтверждение на вашу почту<br /><strong>@Model.Email</strong></p>
    <a asp-controller="Books" asp-action="Index" class="btn-continue">Продолжить покупки</a>
    <br />
    <a asp-action="MyOrders" class="btn-orders">Перейти к заказам</a>
</div>

<style>
    .success-page {
        text-align: center;
        padding: 80px 20px;
        max-width: 500px;
        margin: 0 auto;
    }

    .success-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 3px solid #4caf50;
        color: #4caf50;
        font-size: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
    }

    .success-page h2 {
        font-family: Georgia, serif;
        font-size: 1.8rem;
        color: #4a2c00;
        margin-bottom: 12px;
    }

    .success-num {
        font-size: 1rem;
        color: #555;
        margin-bottom: 8px;
    }

    .success-email {
        font-size: 0.9rem;
        color: #888;
        margin-bottom: 30px;
    }

    .btn-continue {
        display: inline-block;
        background: #b8860b;
        color: #fff;
        padding: 14px 40px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
    }

        .btn-continue:hover {
            background: #9a6f00;
        }

    .btn-orders {
        display: inline-block;
        margin-top: 12px;
        color: #b8860b;
        text-decoration: none;
        font-size: 14px;
    }
</style>