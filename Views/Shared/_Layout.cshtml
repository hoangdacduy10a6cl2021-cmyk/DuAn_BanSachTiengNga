@using Microsoft.EntityFrameworkCore
@using QuanLySach.Models
@inject AppDbContext Db
<!DOCTYPE html>
<html lang="ru" translate="no">
<head>
    <meta charset="utf-8" />
    <meta name="google" content="notranslate" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/site.css?v=4" />
    <title>Книжный Рай — Книжный рай </title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
            .search-dropdown {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background: #fff;
                border: 1px solid #ddd;
                border-radius: 6px;
                box-shadow: 0 6px 16px rgba(0,0,0,0.12);
                max-height: 360px;
                overflow-y: auto;
                z-index: 1000;
            }

                .search-dropdown.show {
                    display: block;
                }

            .search-dropdown-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 12px;
                text-decoration: none;
                color: #333;
                border-bottom: 1px solid #f0f0f0;
            }

                .search-dropdown-item:last-child {
                    border-bottom: none;
                }

                .search-dropdown-item:hover {
                    background: #f7f7f7;
                }

                .search-dropdown-item img {
                    width: 36px;
                    height: 50px;
                    object-fit: cover;
                    border-radius: 3px;
                    flex-shrink: 0;
                }

                .search-dropdown-item .info {
                    display: flex;
                    flex-direction: column;
                    overflow: hidden;
                }

                    .search-dropdown-item .info .title {
                        font-weight: 600;
                        font-size: 13px;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                    }

                    .search-dropdown-item .info .author {
                        font-size: 11px;
                        color: #888;
                    }

                    .search-dropdown-item .info .price {
                        font-size: 12px;
                        color: #c0392b;
                        font-weight: 700;
                    }

            .search-dropdown-empty {
                padding: 12px;
                text-align: center;
                color: #999;
                font-size: 13px;
            }
    </style>
</head>
<body>

    <!-- TOP BAR -->
    <div class="top-bar">
        <div class="container top-bar-inner">
            <div class="top-contacts">
                <span><i class="fas fa-phone"></i> 0946029615</span>
                <span><i class="fas fa-envelope"></i> Русские-книги@gmail.com</span>
            </div>
            <div class="top-links">
                <a href="#" data-i18n="shipping_info">Доставка и оплата</a>
                <a asp-controller="Home" asp-action="About" data-i18n="about_us">О нас</a>
                <a href="#" data-i18n="contact">Контакты</a>
                <div class="lang-selector">
                    <span class="lang-current" id="lang-current-label">
                        <i class="fas fa-globe"></i> RU ▾
                    </span>
                    <ul class="lang-dropdown">
                        <li onclick="setLang('en')">🇬🇧 English</li>
                        <li onclick="setLang('vi')">🇻🇳 Tiếng Việt</li>
                        <li onclick="setLang('ru')">🇷🇺 Русский</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- HEADER -->
    <header class="site-header">
        <div class="container header-inner">
            <div class="logo">
                <img src="~/images/logo.png" alt="Книжный Рай" />
                <div class="logo-text">
                    <h1>Книжный Рай</h1>
                    <span data-i18n="tagline">— Книжный рай —</span>
                </div>
            </div>

            <div class="search-box" style="position:relative">
                <input type="text" id="searchInput" placeholder="Поиск книг..."
                       data-i18n-placeholder="search_placeholder"
                       autocomplete="off"
                       value="@ViewBag.SearchQuery"
                       oninput="liveSearch(this.value)"
                       onkeydown="if(event.key==='Enter') goSearch()" />
                <button onclick="goSearch()"><i class="fas fa-search"></i></button>
                <!-- DROPDOWN KẾT QUẢ -->
                <div class="search-dropdown" id="searchDropdown"></div>
            </div>

            <div class="header-actions">
                @if (Context.Session.GetString("UserName") != null)
                {
                    <a asp-controller="Account" asp-action="Profile" class="action-btn">
                        <i class="fas fa-user-circle"></i>
                        <span>@Context.Session.GetString("UserName")</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="action-btn">
                        <i class="fas fa-user"></i>
                        <span><span data-i18n="login">Войти</span><br /><span data-i18n="account">Аккаунт</span></span>
                    </a>
                }
                <a asp-controller="Cart" asp-action="Index" class="action-btn">
                    <i class="fas fa-shopping-cart"></i>
                    @{
                        var cartTotal = Db.CartItems
                            .Where(c => c.SessionId == Context.Session.Id)
                            .Include(c => c.Book)
                            .Sum(c => c.Book != null ? c.Book.Price * c.Quantity : 0);
                    }
                    <span><span data-i18n="cart">Корзина</span><br /><span id="cart-total-text">@cartTotal.ToString("N0") ₽</span></span>
                </a>
            </div>
        </div>
    </header>

    <!-- NAV -->
    <nav class="main-nav">
        <div class="container" style="position:relative;">
            <button class="mobile-menu-btn" onclick="toggleMobileMenu()">
                <i class="fas fa-bars" id="menu-icon"></i>
            </button>
            <ul id="main-menu">
                <li><a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> <span data-i18n="home">Главная</span></a></li>
                <li class="has-dropdown">
                    <a href="#" onclick="toggleDropdown(event, this)"><span data-i18n="books">Книги</span> <i class="fas fa-chevron-down"></i></a>
                    <ul class="dropdown">
                        <li><a asp-controller="Books" asp-action="Index" data-i18n="all_books">Все книги</a></li>
                        <li><a asp-controller="Books" asp-action="ComingSoon" data-i18n="new_arrivals">Новинки</a></li>
                    </ul>
                </li>
                <li><a asp-controller="Home" asp-action="NewBooks" data-i18n="new_arrivals">Новинки</a></li>
                <li><a asp-controller="Home" asp-action="Popular" data-i18n="popular">Популярное</a></li>
                <li><a asp-controller="Home" asp-action="Promotions" data-i18n="promotions">Акции</a></li>
                <li><a asp-controller="Home" asp-action="Contact" data-i18n="contact">Контакты</a></li>
            </ul>
        </div>
    </nav>

    <!-- CONTENT -->
    <main>
        @RenderBody()
    </main>

    @if (ViewData["HideFooter"] == null || !(bool)ViewData["HideFooter"])
    {
        <!-- FEATURES BAR -->
        <div class="features-bar">
            <div class="container features-inner">
                <div class="feature">
                    <i class="fas fa-book-open"></i>
                    <div>
                        <strong data-i18n="feature1_title">Широкий ассортимент</strong>
                        <span data-i18n="feature1_desc">Тысячи книг на любой вкус</span>
                    </div>
                </div>
                <div class="feature">
                    <i class="fas fa-truck"></i>
                    <div>
                        <strong data-i18n="feature2_title">Быстрая доставка</strong>
                        <span data-i18n="feature2_desc">Доставка по всей России</span>
                    </div>
                </div>
                <div class="feature">
                    <i class="fas fa-shield-alt"></i>
                    <div>
                        <strong data-i18n="feature3_title">Гарантия качества</strong>
                        <span data-i18n="feature3_desc">Только оригинальные книги</span>
                    </div>
                </div>
                <div class="feature">
                    <i class="fas fa-tag"></i>
                    <div>
                        <strong data-i18n="feature4_title">Скидки и акции</strong>
                        <span data-i18n="feature4_desc">Выгодные предложения</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <footer class="site-footer">
            <div class="container footer-inner">
                <div class="footer-logo">
                    <img src="~/images/logo.png" alt="Книжный Рай" />
                    <div>
                        <h3>Книжный Рай</h3>
                        <span data-i18n="tagline">— Книжный рай —</span>
                    </div>
                    <div class="social-links">
                        <a href="#"><i class="fab fa-vk"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-telegram"></i></a>
                    </div>
                </div>

                <div class="footer-col">
                    <h4 data-i18n="catalog">Каталог</h4>
                    <ul>
                        <li><a asp-controller="Books" asp-action="Index" data-i18n="all_books">Все книги</a></li>
                        <li><a asp-controller="Books" asp-action="Index" data-i18n="categories">Категории</a></li>
                        <li><a asp-controller="Home" asp-action="NewBooks" data-i18n="new_arrivals">Новинки</a></li>
                        <li><a asp-controller="Home" asp-action="Popular" data-i18n="popular">Популярное</a></li>
                        <li><a asp-controller="Home" asp-action="Promotions" data-i18n="promotions">Акции</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4 data-i18n="for_buyers">Покупателям</h4>
                    <ul>
                        <li><a href="#" data-i18n="shipping_info">Доставка и оплата</a></li>
                        <li><a href="#" data-i18n="returns">Возврат</a></li>
                        <li><a href="#" data-i18n="help">Помощь</a></li>
                        <li><a asp-controller="Home" asp-action="Contact" data-i18n="contact">Контакты</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4 data-i18n="contact">Контакты</h4>
                    <ul>
                        <li><i class="fas fa-phone"></i> 0946029615</li>
                        <li><i class="fas fa-envelope"></i> Русские-книги@gmail.com</li>
                        <li><i class="fas fa-map-marker-alt"></i> <span data-i18n="address">ул. Мясницкая, д. 6/3, стр. 1, Москва, Россия, 101000</span></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p data-i18n="copyright">© 2026 Книжный Рай. Все права защищены.</p>
            </div>
        </footer>
    }

    @if (TempData["ToastSuccess"] != null)
    {
        <div id="toast-success">
            <i class="fas fa-check-circle"></i> @TempData["ToastSuccess"]
        </div>
    }

    @if (TempData["ToastError"] != null)
    {
        <div id="toast-error">
            <i class="fas fa-circle-exclamation"></i> @TempData["ToastError"]
        </div>
    }

    <style>
            #toast-success {
                position: fixed;
                bottom: 30px;
                left: 50%;
                transform: translateX(-50%);
                background: #2e7d32;
                color: #fff;
                padding: 14px 28px;
                border-radius: 8px;
                font-size: 15px;
                font-weight: 600;
                z-index: 9999;
                box-shadow: 0 4px 16px rgba(0,0,0,0.2);
                white-space: nowrap;
                animation: fadeInOut 3s forwards;
            }

            #toast-error {
                position: fixed;
                bottom: 30px;
                left: 50%;
                transform: translateX(-50%);
                background: #c0392b;
                color: #fff;
                padding: 14px 28px;
                border-radius: 8px;
                font-size: 15px;
                font-weight: 600;
                z-index: 9999;
                box-shadow: 0 4px 16px rgba(0,0,0,0.2);
                white-space: normal;
                max-width: 90vw;
                text-align: center;
                animation: fadeInOut 4s forwards;
            }

            @@keyframes fadeInOut {
                0% {
                    opacity: 0;
                    transform: translateX(-50%) translateY(20px);
                }

                15% {
                    opacity: 1;
                    transform: translateX(-50%) translateY(0);
                }

                75% {
                    opacity: 1;
                }

                100% {
                    opacity: 0;
                    transform: translateX(-50%) translateY(20px);
                }
            }
    </style>

    <script src="~/js/site.js?v=2"></script>
    <script src="~/js/i18n.js?v=1"></script>
    <script>
            function toggleMobileMenu() {
                const menu = document.getElementById('main-menu');
                const icon = document.getElementById('menu-icon');
                menu.classList.toggle('open');
                icon.className = menu.classList.contains('open')
                    ? 'fas fa-times'
                    : 'fas fa-bars';
            }

            function toggleDropdown(e, el) {
                if (window.innerWidth <= 768) {
                    e.preventDefault();
                    el.parentElement.classList.toggle('open');
                }
            }

            document.addEventListener('click', function (e) {
                const nav = document.querySelector('.main-nav');
                if (!nav.contains(e.target)) {
                    document.getElementById('main-menu').classList.remove('open');
                    document.getElementById('menu-icon').className = 'fas fa-bars';
                }
            });

            // ===== LIVE SEARCH =====
            let searchDebounceTimer = null;

            function liveSearch(value) {
                clearTimeout(searchDebounceTimer);
                const dropdown = document.getElementById('searchDropdown');

                if (!value || value.trim().length === 0) {
                    dropdown.classList.remove('show');
                    dropdown.innerHTML = '';
                    return;
                }

                searchDebounceTimer = setTimeout(async () => {
                    try {
                        const res = await fetch('/Books/LiveSearch?q=' + encodeURIComponent(value.trim()));
                        const data = await res.json();
                        renderSearchDropdown(data);
                    } catch (err) {
                        console.error('Search error:', err);
                    }
                }, 300);
            }

            function renderSearchDropdown(items) {
                const dropdown = document.getElementById('searchDropdown');

                if (!items || items.length === 0) {
                    dropdown.innerHTML = '<div class="search-dropdown-empty">Не найдено</div>';
                    dropdown.classList.add('show');
                    return;
                }

                dropdown.innerHTML = items.map(item => `
                    <a class="search-dropdown-item" href="/Books/Detail/${item.id}">
                    <img src="${item.image || '/images/no-image.png'}" alt="${item.title}" />
                    <div class="info">
                    <span class="title">${item.title}</span>
                    <span class="author">${item.author || ''}</span>
                    <span class="price">${formatPrice(item.price)}</span>
                    </div>
                    </a>
                    `).join('');

                dropdown.classList.add('show');
            }

            function formatPrice(price) {
                if (price == null) return '';
                return Number(price).toLocaleString('ru-RU') + ' ₽';
            }

            function goSearch() {
                const value = document.getElementById('searchInput').value.trim();
                if (value.length === 0) return;
                window.location.href = '/Books/Search?q=' + encodeURIComponent(value);
            }

            document.addEventListener('click', function (e) {
                const box = document.querySelector('.search-box');
                const dropdown = document.getElementById('searchDropdown');
                if (box && dropdown && !box.contains(e.target)) {
                    dropdown.classList.remove('show');
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>