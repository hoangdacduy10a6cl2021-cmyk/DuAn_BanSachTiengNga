@model QuanLySach.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "Контакты";
}

<div class="ct-page">

    <!-- Trang trí góc (mờ) -->
    <div class="ct-deco ct-deco-left" aria-hidden="true">
        <i class="fas fa-leaf"></i>
        <i class="fas fa-book"></i>
    </div>
    <div class="ct-deco ct-deco-right" aria-hidden="true">
        <i class="fas fa-book-open"></i>
        <i class="fas fa-leaf"></i>
    </div>

    <div class="container">

        @if (TempData["ContactSuccess"] != null)
        {
            <div class="ct-alert-success">@TempData["ContactSuccess"]</div>
        }

        <div class="ct-card">

            <!-- LEFT: THÔNG TIN LIÊN HỆ -->
            <section class="ct-info">
                <span class="ct-accent"></span>
                <h2 class="ct-title">Свяжитесь с нами</h2>
                <p class="ct-lead">
                    Мы всегда готовы помочь и ответить на любые ваши вопросы.
                    Свяжитесь с нами одним из способов ниже или напишите нам прямо сейчас!
                </p>

                <ul class="ct-list">
                    <li class="ct-item">
                        <span class="ct-icon"><i class="fas fa-map-marker-alt"></i></span>
                        <div>
                            <h3>Адрес</h3>
                            <p>ул. Мясницкая, д. 6/3, стр. 1, Москва, Россия, 101000</p>
                        </div>
                    </li>

                    <li class="ct-item">
                        <span class="ct-icon"><i class="fas fa-phone"></i></span>
                        <div>
                            <h3>Телефон</h3>
                            <p class="notranslate" translate="no">0946029615</p>
                        </div>
                    </li>

                    <li class="ct-item">
                        <span class="ct-icon"><i class="fas fa-envelope"></i></span>
                        <div>
                            <h3>E-mail</h3>
                            <p class="notranslate" translate="no">Русские-книги@gmail.com</p>
                        </div>
                    </li>

                    <li class="ct-item">
                        <span class="ct-icon"><i class="fas fa-clock"></i></span>
                        <div>
                            <h3>Время работы</h3>
                            <p>Ежедневно с 9:00 до 21:00</p>
                        </div>
                    </li>
                </ul>
            </section>

            <!-- RIGHT: FORM -->
            <section class="ct-form">
                <span class="ct-accent"></span>
                <h2 class="ct-title">Напишите нам</h2>
                <p class="ct-lead">Пожалуйста, заполните форму ниже — мы ответим как можно скорее!</p>

                <form asp-controller="Home" asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="ct-validation"></div>

                    <div class="ct-field">
                        <label for="Name">Имя</label>
                        <input asp-for="Name" type="text" placeholder="Введите ваше имя" />
                        <span asp-validation-for="Name" class="ct-error"></span>
                    </div>

                    <div class="ct-field">
                        <label for="Email">E-mail</label>
                        <input asp-for="Email" type="email" placeholder="Введите ваш e-mail" />
                        <span asp-validation-for="Email" class="ct-error"></span>
                    </div>

                    <div class="ct-field">
                        <label for="Message">Сообщение</label>
                        <textarea asp-for="Message" rows="4" placeholder="Введите ваше сообщение"></textarea>
                        <span asp-validation-for="Message" class="ct-error"></span>
                    </div>

                    <button type="submit" class="ct-btn">
                        <i class="fas fa-paper-plane"></i> Отправить сообщение
                    </button>
                </form>
            </section>

        </div>

        <!-- TIN NHẮN CỦA BẠN -->
        @if (Model.MyMessages.Any())
        {
            <div class="my-messages">
                <h3>Ваши сообщения</h3>

                @foreach (var m in Model.MyMessages)
                {
                    <div class="my-message-card">
                        <div class="my-message-head">
                            <span class="my-message-date">@m.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            @if (m.AdminReply != null)
                            {
                                <span class="my-message-status replied">Ответ получен</span>
                            }
                            else
                            {
                                <span class="my-message-status pending">Ожидает ответа</span>
                            }
                        </div>
                        <p class="my-message-text">@m.Message</p>

                        @if (m.AdminReply != null)
                        {
                            <div class="my-message-reply">
                                <strong><i class="fas fa-reply"></i> Ответ от &laquo;Книжный Рай&raquo; — @m.RepliedAt?.ToString("dd/MM/yyyy HH:mm")</strong>
                                <p>@m.AdminReply</p>
                            </div>
                        }
                    </div>
                }
            </div>
        }

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    /* ===== TRANG LIÊN HỆ ===== */
    .ct-page {
        position: relative;
        overflow: hidden;
        padding: 56px 0 80px;
        background: linear-gradient(180deg, #fdf8ee 0%, #fbf3e2 100%);
    }

        .ct-page .container {
            position: relative;
            z-index: 1;
        }

    /* Trang trí 2 góc dưới */
    .ct-deco {
        position: absolute;
        bottom: 0;
        z-index: 0;
        display: flex;
        align-items: flex-end;
        gap: 6px;
        color: #b8860b;
        opacity: 0.09;
        line-height: 1;
        pointer-events: none;
    }

    .ct-deco-left {
        left: 1.5%;
    }

    .ct-deco-right {
        right: 1.5%;
    }

    .ct-deco .fa-book,
    .ct-deco .fa-book-open {
        font-size: 150px;
    }

    .ct-deco .fa-leaf {
        font-size: 90px;
        margin-bottom: 90px;
    }

    .ct-deco-left .fa-leaf {
        transform: rotate(-30deg);
    }

    .ct-deco-right .fa-leaf {
        transform: rotate(30deg) scaleX(-1);
    }

    .ct-alert-success {
        margin: 0 0 24px;
        padding: 14px 20px;
        background: #e8f5e9;
        color: #2e7d32;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
    }

    /* Thẻ lớn 2 cột */
    .ct-card {
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: #fffdf8;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(120, 86, 20, 0.10);
    }

    .ct-info,
    .ct-form {
        position: relative;
        padding: 38px 48px 44px;
    }

    /* Đường kẻ dọc giữa 2 cột */
    .ct-form::before {
        content: "";
        position: absolute;
        left: 0;
        top: 38px;
        bottom: 38px;
        width: 1px;
        background: #ece3d0;
    }

    .ct-accent {
        display: block;
        width: 58px;
        height: 4px;
        margin-bottom: 18px;
        background: #b8860b;
        border-radius: 2px;
    }

    .ct-title {
        margin: 0 0 14px;
        font-family: 'Playfair Display', serif;
        font-size: 38px;
        font-weight: 700;
        line-height: 1.15;
        color: #2c1a0e;
    }

    .ct-lead {
        margin: 0 0 26px;
        font-size: 16px;
        line-height: 1.65;
        color: #5f6675;
    }

    .ct-info .ct-lead {
        max-width: 470px;
        font-size: 17px;
    }

    /* Danh sách thông tin */
    .ct-list {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .ct-item {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 16px 0;
        border-bottom: 1px solid #ece3d0;
    }

        .ct-item:last-child {
            border-bottom: none;
        }

    .ct-icon {
        flex: 0 0 56px;
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #b8860b;
        color: #fff;
        font-size: 22px;
        box-shadow: 0 3px 8px rgba(184, 134, 11, 0.30);
    }

    .ct-item h3 {
        margin: 0 0 4px;
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        font-weight: 700;
        color: #7a4b0c;
    }

    .ct-item p {
        margin: 0;
        font-size: 17px;
        line-height: 1.4;
        color: #5f6675;
        overflow-wrap: anywhere;
    }

    /* Form */
    .ct-field {
        margin-bottom: 18px;
    }

        .ct-field label {
            display: block;
            margin-bottom: 8px;
            font-size: 16px;
            font-weight: 700;
            color: #2c1a0e;
        }

        .ct-field input,
        .ct-field textarea {
            width: 100%;
            box-sizing: border-box;
            padding: 13px 16px;
            border: 1px solid #e3d9c3;
            border-radius: 8px;
            background: #fff;
            font-family: 'Lato', sans-serif;
            font-size: 15px;
            color: #2c1a0e;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .ct-field input::placeholder,
            .ct-field textarea::placeholder {
                color: #9aa0ab;
            }

            .ct-field input:focus,
            .ct-field textarea:focus {
                outline: none;
                border-color: #b8860b;
                box-shadow: 0 0 0 3px rgba(184, 134, 11, 0.15);
            }

        .ct-field textarea {
            min-height: 112px;
            resize: vertical;
        }

    .ct-error {
        display: block;
        margin-top: 5px;
        font-size: 12px;
        color: #c0392b;
    }

    .ct-validation ul {
        margin: 0 0 16px;
        padding-left: 18px;
        font-size: 13px;
        color: #c0392b;
    }

    .ct-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 16px;
        border: none;
        border-radius: 8px;
        background: #b8860b;
        color: #fff;
        font-family: 'Lato', sans-serif;
        font-size: 18px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(184, 134, 11, 0.30);
        transition: background 0.2s, transform 0.1s;
    }

        .ct-btn:hover {
            background: #9a6f00;
        }

        .ct-btn:active {
            transform: translateY(1px);
        }

    /* Lịch sử tin nhắn */
    .my-messages {
        margin: 36px 0 0;
    }

        .my-messages h3 {
            margin-bottom: 16px;
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            color: #2c1a0e;
        }

    .my-message-card {
        margin-bottom: 14px;
        padding: 18px 22px;
        background: #fffdf8;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(120, 86, 20, 0.08);
    }

    .my-message-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .my-message-date {
        font-size: 12px;
        color: #999;
    }

    .my-message-status {
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

        .my-message-status.replied {
            background: #e8f5e9;
            color: #2e7d32;
        }

        .my-message-status.pending {
            background: #fff3e0;
            color: #b8860b;
        }

    .my-message-text {
        margin: 0 0 10px;
        font-size: 14px;
        color: #333;
    }

    .my-message-reply {
        padding: 10px 14px;
        background: #fff8e6;
        border-left: 3px solid #b8860b;
        border-radius: 6px;
    }

        .my-message-reply strong {
            display: block;
            margin-bottom: 4px;
            font-size: 12px;
            color: #b8860b;
        }

        .my-message-reply p {
            margin: 0;
            font-size: 14px;
            color: #333;
        }

    /* ===== TABLET / MOBILE ===== */
    @@media (max-width: 900px) {
        .ct-page {
            padding: 28px 0 48px;
        }

        .ct-card {
            grid-template-columns: 1fr;
            border-radius: 16px;
        }

        .ct-info,
        .ct-form {
            padding: 28px 22px;
        }

        /* Đường kẻ dọc chuyển thành đường kẻ ngang */
        .ct-form::before {
            left: 22px;
            right: 22px;
            top: 0;
            bottom: auto;
            width: auto;
            height: 1px;
        }

        .ct-form {
            padding-top: 34px;
        }

        .ct-title {
            font-size: 28px;
        }

        .ct-info .ct-lead {
            font-size: 15px;
        }

        .ct-icon {
            flex-basis: 48px;
            width: 48px;
            height: 48px;
            font-size: 19px;
        }

        .ct-item p {
            font-size: 15px;
        }

        .ct-deco {
            display: none;
        }
    }
</style>