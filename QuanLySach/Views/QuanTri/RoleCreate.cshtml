@using QuanLySach.Models
@model Role
@{
    Layout = "_QuanTriLayout";
    ViewBag.Title = "Thêm vai trò";
}

<div class="admin-panel">
    <form asp-action="RoleCreate" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label>Tên vai trò</label>
            <input type="text" asp-for="Name" required autofocus />
        </div>
        <div class="form-group">
            <label>Mô tả</label>
            <textarea asp-for="Description" rows="3"></textarea>
        </div>
        <button type="submit" class="btn btn-gold">Lưu</button>
        <a asp-action="Roles" class="btn btn-outline">Hủy</a>
    </form>
</div>