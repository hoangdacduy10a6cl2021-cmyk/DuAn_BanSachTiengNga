@using QuanLySach.Models
@model Book
@{
    Layout = "_QuanTriLayout";
    ViewBag.Title = "Sửa sách";
}

<div class="admin-panel">
    <form asp-action="BookEdit" asp-route-id="@Model.Id" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label>Tên sách</label>
            <input type="text" asp-for="Title" required />
        </div>

        <div class="form-group">
            <label>Tác giả</label>
            <input type="text" asp-for="Author" required />
        </div>

        <div class="form-group">
            <label>Danh mục</label>
            <select asp-for="CategoryId" required>
                @foreach (var cat in (List<Category>)ViewBag.Categories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Giá (₽)</label>
            <input type="number" step="0.01" asp-for="Price" required />
        </div>

        <div class="form-group">
            <label>Link ảnh bìa</label>
            <input type="text" asp-for="CoverImageUrl" />
        </div>

        <div class="form-group form-check">
            <input type="checkbox" asp-for="IsNew" />
            <label style="margin:0">Sách mới</label>
        </div>

        <div class="form-group form-check">
            <input type="checkbox" asp-for="IsPopular" />
            <label style="margin:0">Sách nổi bật</label>
        </div>

        <button type="submit" class="btn btn-gold">Cập nhật</button>
        <a asp-action="Books" class="btn btn-outline">Hủy</a>
    </form>
</div>