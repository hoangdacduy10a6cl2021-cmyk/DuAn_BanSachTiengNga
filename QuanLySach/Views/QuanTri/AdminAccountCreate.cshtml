@using QuanLySach.Models
@{
    Layout = "_QuanTriLayout";
    ViewBag.Title = "Thêm tài khoản Admin";
}

<div class="admin-panel">
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-error">@ViewBag.Error</div>
    }
    <form asp-action="AdminAccountCreate" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label>Tên đăng nhập</label>
            <input type="text" name="username" required autofocus />
        </div>
        <div class="form-group">
            <label>Mật khẩu</label>
            <input type="password" name="password" required />
        </div>
        <div class="form-group">
            <label>Họ tên</label>
            <input type="text" name="fullName" required />
        </div>
        <div class="form-group">
            <label>Vai trò</label>
            <select name="roleId" required>
                @foreach (var role in (List<Role>)ViewBag.Roles)
                {
                    <option value="@role.Id">@role.Name</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-gold">Lưu</button>
        <a asp-action="AdminAccounts" class="btn btn-outline">Hủy</a>
    </form>
</div>