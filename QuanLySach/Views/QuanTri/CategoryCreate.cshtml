@using QuanLySach.Models
@model Category
@{
    Layout = "_QuanTriLayout";
    ViewBag.Title = "Thêm danh mục";
}

<div class="admin-panel">
    <form asp-action="CategoryCreate" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label>Tên danh mục</label>
            <input type="text" asp-for="Name" required autofocus />
        </div>
        <button type="submit" class="btn btn-gold">Lưu</button>
        <a asp-action="Categories" class="btn btn-outline">Hủy</a>
    </form>
</div>