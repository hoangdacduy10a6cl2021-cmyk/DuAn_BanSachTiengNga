@using QuanLySach.Models
@model List<Order>
@{
    Layout = "_QuanTriLayout";
    ViewBag.Title = "Quản lý đơn hàng";
}

<div class="admin-panel">
    <div class="panel-header">
        <h2>Đơn hàng (@Model.Count)</h2>
    </div>
    <table class="admin-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Khách hàng</th>
                <th>Điện thoại</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>#@order.Id</td>
                    <td>@order.Name</td>
                    <td>@order.Phone</td>
                    <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@order.TotalPrice.ToString("N0") ₽</td>
                    <td><span class="badge">@order.Status</span></td>
                    <td><a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-outline btn-sm">Chi tiết</a></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7">Chưa có đơn hàng nào.</td></tr>
            }
        </tbody>
    </table>
</div>