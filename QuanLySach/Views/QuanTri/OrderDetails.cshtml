@using QuanLySach.Models
@model Order
@{
    Layout = "_QuanTriLayout";
    ViewBag.Title = $"Đơn hàng #{Model.Id}";
}

<div class="admin-panel">
    <div class="panel-header">
        <h2>Thông tin khách hàng</h2>
    </div>
    <p><strong>Họ tên:</strong> @Model.Name</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Điện thoại:</strong> @Model.Phone</p>
    <p><strong>Địa chỉ:</strong> @Model.City, @Model.Street @Model.House @Model.Apartment, @Model.PostalCode</p>
    <p><strong>Phương thức giao hàng:</strong> @Model.DeliveryMethod (@Model.DeliveryPrice.ToString("N0") ₽)</p>
    <p><strong>Ngày đặt:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>

    <form asp-action="OrderUpdateStatus" asp-route-id="@Model.Id" method="post" class="admin-form" style="max-width:320px; margin-top:16px;">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label>Trạng thái đơn hàng</label>
            <select name="status">
                @foreach (var s in new[] { "Новый", "Đang xử lý", "Đang giao", "Hoàn thành", "Đã hủy" })
                {
                    if (s == Model.Status)
                    {
                        <option value="@s" selected>@s</option>
                    }
                    else
                    {
                        <option value="@s">@s</option>
                    }
                }
            </select>
        </div>
        <button type="submit" class="btn btn-gold btn-sm">Cập nhật trạng thái</button>
    </form>
</div>

<div class="admin-panel">
    <div class="panel-header">
        <h2>Sản phẩm trong đơn</h2>
    </div>
    <table class="admin-table">
        <thead>
            <tr>
                <th>Sách</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@(item.Book?.Title ?? "(Sách đã bị xóa)")</td>
                    <td>@item.Quantity</td>
                    <td>@item.Price.ToString("N0") ₽</td>
                    <td>@((item.Price * item.Quantity).ToString("N0")) ₽</td>
                </tr>
            }
        </tbody>
    </table>
    <p style="text-align:right; margin-top:12px; font-weight:700;">
        Tổng cộng: @Model.TotalPrice.ToString("N0") ₽
    </p>
</div>

<a asp-action="Orders" class="btn btn-outline">← Quay lại danh sách</a>