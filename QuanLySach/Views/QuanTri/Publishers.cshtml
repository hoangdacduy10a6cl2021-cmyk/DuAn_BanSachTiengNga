@using QuanLySach.Models
@model List<Publisher>
@{
    Layout = "_QuanTriLayout";
    ViewBag.Title = "Управление издательствами";
}

<div class="admin-panel">
    <div class="panel-header">
        <h2>Издательства (@Model.Count)</h2>
        <div style="display:flex; gap:10px;">
            <form method="get" style="display:flex;">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Поиск по названию..." style="padding:7px 10px; border:1px solid #ddd; border-radius:6px 0 0 6px; font-size:0.85rem;" />
                <button type="submit" style="padding:7px 12px; border:none; background:#f5e6c8; color:#4a2c17; border-radius:0 6px 6px 0; cursor:pointer;"><i class="fas fa-search"></i></button>
            </form>
            <a asp-action="PublisherCreate" class="btn btn-gold btn-sm"><i class="fas fa-plus"></i> Добавить издательство</a>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace((string)ViewBag.SearchTerm))
    {
        <p style="color:var(--text-mid); font-size:0.85rem; margin-top:-8px; margin-bottom:14px;">
            Результаты поиска по запросу "<strong>@ViewBag.SearchTerm</strong>" — <a asp-action="Publishers" style="color:#b8860b;">Сбросить фильтр</a>
        </p>
    }
    <table class="admin-table">
        <thead>
            <tr>
                <th>Название</th>
                <th>Адрес</th>
                <th>Описание</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pub in Model)
            {
                <tr>
                    <td>@pub.Name</td>
                    <td>@(string.IsNullOrWhiteSpace(pub.Address) ? "—" : pub.Address)</td>
                    <td style="max-width:360px; color:#555;">@(string.IsNullOrWhiteSpace(pub.Description) ? "—" : pub.Description)</td>
                    <td>
                        <a asp-action="PublisherEdit" asp-route-id="@pub.Id" class="btn btn-outline btn-sm">Изменить</a>
                        <form asp-action="PublisherDelete" asp-route-id="@pub.Id" method="post" style="display:inline" onsubmit="return confirm('Удалить это издательство?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4">Издательств пока нет.</td></tr>
            }
        </tbody>
    </table>
</div>