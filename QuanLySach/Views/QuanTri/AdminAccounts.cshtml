@using QuanLySach.Models
@model List<Admin>
@{
    Layout = "_QuanTriLayout";
    ViewBag.Title = "Tài khoản Admin";
}

<div class="admin-panel">
    <div class="panel-header">
        <h2>Tài khoản Admin (@Model.Count)</h2>
        <a asp-action="AdminAccountCreate" class="btn btn-gold btn-sm"><i class="fas fa-plus"></i> Thêm tài khoản</a>
    </div>
    <table class="admin-table">
        <thead>
            <tr>
                <th>Tên đăng nhập</th>
                <th>Họ tên</th>
                <th>Vai trò</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var acc in Model)
            {
                <tr>
                    <td>@acc.Username</td>
                    <td>@acc.FullName</td>
                    <td><span class="badge">@(acc.Role?.Name ?? "—")</span></td>
                    <td>
                        <a asp-action="AdminAccountEdit" asp-route-id="@acc.Id" class="btn btn-outline btn-sm">Sửa</a>
                        <form asp-action="AdminAccountDelete" asp-route-id="@acc.Id" method="post" style="display:inline" onsubmit="return confirm('Xóa tài khoản này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>