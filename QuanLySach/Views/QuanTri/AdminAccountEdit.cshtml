@using QuanLySach.Models
@model Admin
@{
    Layout = "_QuanTriLayout";
    ViewBag.Title = "Sửa tài khoản Admin";
}

<div class="admin-panel">
    <form asp-action="AdminAccountEdit" asp-route-id="@Model.Id" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label>Tên đăng nhập</label>
            <input type="text" value="@Model.Username" disabled />
        </div>
        <div class="form-group">
            <label>Họ tên</label>
            <input type="text" name="fullName" value="@Model.FullName" required />
        </div>
        <div class="form-group">
            <label>Vai trò</label>
            <select name="roleId" required>
                @foreach (var role in (List<Role>)ViewBag.Roles)
                {
                    if (role.Id == Model.RoleId)
                    {
                        <option value="@role.Id" selected>@role.Name</option>
                    }
                    else
                    {
                        <option value="@role.Id">@role.Name</option>
                    }
                }
            </select>
        </div>
        <div class="form-group">
            <label>Mật khẩu mới (để trống nếu không đổi)</label>
            <input type="password" name="newPassword" />
        </div>
        <button type="submit" class="btn btn-gold">Cập nhật</button>
        <a asp-action="AdminAccounts" class="btn btn-outline">Hủy</a>
    </form>
</div>