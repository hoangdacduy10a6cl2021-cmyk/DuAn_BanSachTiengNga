@using QuanLySach.Models
@model Role
@{
    Layout = "_QuanTriLayout";
    ViewBag.Title = "Редактировать роль";
}

<div class="admin-panel">
    <form asp-action="RoleEdit" asp-route-id="@Model.Id" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label>Название роли</label>
            <input type="text" asp-for="Name" required />
        </div>
        <div class="form-group">
            <label>Описание</label>
            <textarea asp-for="Description" rows="3"></textarea>
        </div>
        <button type="submit" class="btn btn-gold">Обновить</button>
        <a asp-action="Roles" class="btn btn-outline">Отмена</a>
    </form>
</div>