@model QuanLySach.Models.Book

<div class="book-card">
    <div class="book-cover">
        <img src="@Model.CoverImageUrl" alt="@Model.Title" />
        <button class="wishlist-btn" onclick="toggleWishlist(@Model.Id, this)">
            <i class="fas fa-heart"></i>
        </button>
    </div>
    <div class="book-info">
        <h4>@Model.Title</h4>
        <p class="author">@Model.Author</p>
        <p class="price">@Model.Price ₽</p>
        <button class="btn-cart"
                data-book-id="@Model.Id"
                onclick="addToCart(@Model.Id)">
            <i class="fas fa-shopping-cart"></i> В корзину
        </button>
    </div>
</div>