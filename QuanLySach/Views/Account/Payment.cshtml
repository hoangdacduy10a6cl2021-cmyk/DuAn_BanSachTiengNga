@model List<QuanLySach.Models.PaymentCard>

@{
    ViewData["Title"] = "Способы оплаты";
    ViewData["ActiveMenu"] = "Payment";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="profile-page">
    <div class="container">
        <div class="profile-layout">
            <partial name="_ProfileSidebar" />

            <div class="profile-content">
                <h2>Мои способы оплаты</h2>

                @if (TempData["CardSuccess"] != null)
                {
                    <div class="alert-success">✓ @TempData["CardSuccess"]</div>
                }

                <div class="payment-section">
                    <h3>Способы оплаты</h3>

                    <!-- VIETCOMBANK -->
                    <div class="payment-method-item" onclick="toggleQR('vcb')" style="cursor:pointer">
                        <div class="payment-method-logo vcb"><span>VCB</span></div>
                        <span>Vietcombank — 1035382800</span>
                        <i class="fas fa-qrcode payment-qr-icon"></i>
                    </div>
                    <div id="qr-vcb" class="qr-inline" style="display:none">
                        <div class="qr-inline-box">
                            <div class="qr-bank-header vcb"><i class="fas fa-bank"></i> Ngân hàng Vietcombank</div>
                            <img src="https://img.vietqr.io/image/vietcombank-1035382800-compact2.jpg"
                                 alt="QR Vietcombank" class="qr-inline-img" />
                            <div class="qr-info">
                                <div class="qr-info-row"><span>Счёт:</span><strong>1035382800</strong></div>
                                <div class="qr-info-row"><span>Владелец:</span><strong>PHAM DUC HOA</strong></div>
                            </div>
                            <p class="qr-note">Откройте приложение банка и отсканируйте QR-код</p>
                        </div>
                    </div>

                    <!-- ZALOPAY -->
                    <div class="payment-method-item" onclick="toggleQR('zalo')" style="cursor:pointer">
                        <div class="payment-method-logo zalopay"><span>ZaloPay</span></div>
                        <span>Кошелёк ZaloPay — PHAM DUC HOA</span>
                        <i class="fas fa-qrcode payment-qr-icon"></i>
                    </div>
                    <div id="qr-zalo" class="qr-inline" style="display:none">
                        <div class="qr-inline-box">
                           <div class="qr-bank-header zalopay"><i class="fas fa-wallet"></i> ZaloPay</div>
                            <img src="/images/zalopay-qr.png"
                                 alt="QR ZaloPay" class="qr-inline-img" />
                            <div class="qr-info">
                                <div class="qr-info-row"><span>Владелец:</span><strong>PHAM DUC HOA</strong></div>
                            </div>
                            <p class="qr-note">Откройте ZaloPay и отсканируйте QR-код</p>
                        </div>
                    </div>

                    <!-- COD - THANH TOÁN TRỰC TIẾP -->
                    <div class="payment-method-item" onclick="toggleQR('cod')" style="cursor:pointer">
                        <div class="payment-method-logo cod"><span>COD</span></div>
                        <span>Наличными при получении</span>
                        <i class="fas fa-chevron-down payment-qr-icon" id="chevron-cod"></i>
                    </div>
                    <div id="qr-cod" class="qr-inline" style="display:none">
                        <div class="qr-inline-box cod-box">

                            <!-- Header -->
                            <div class="cod-header">
                                <div class="cod-icon-circle">
                                    <i class="fas fa-money-bill-wave"></i>
                                </div>
                                <div>
                                    <div class="cod-title">Оплата при получении</div>
                                    <div class="cod-subtitle">Без предоплаты — платите только при получении</div>
                                </div>
                            </div>

                            <!-- Các bước -->
                            <div class="cod-steps">
                                <div class="cod-step">
                                    <span class="cod-step-num">1</span>
                                    <div class="cod-step-text">
                                        <strong>Оформите заказ</strong>
                                        <span>Выберите книги и укажите адрес доставки</span>
                                    </div>
                                </div>
                                <div class="cod-step">
                                    <span class="cod-step-num">2</span>
                                    <div class="cod-step-text">
                                        <strong>Подтверждение магазина</strong>
                                        <span>Мы свяжемся с вами для подтверждения</span>
                                    </div>
                                </div>
                                <div class="cod-step">
                                    <span class="cod-step-num">3</span>
                                    <div class="cod-step-text">
                                        <strong>Ожидайте курьера</strong>
                                        <span>Курьер свяжется с вами перед приездом</span>
                                    </div>
                                </div>
                                <div class="cod-step">
                                    <span class="cod-step-num">4</span>
                                    <div class="cod-step-text">
                                        <strong>Проверьте и оплатите</strong>
                                        <span>Осмотрите заказ и передайте деньги курьеру</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Ghi chú -->
                            <div class="cod-note">
                                <i class="fas fa-info-circle"></i>
                                <span>Доставка по всей стране. Может взиматься дополнительная плата.</span>
                            </div>

                            <span class="cod-badge-free">✓ Бесплатно</span>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .payment-section {
        margin-bottom: 30px;
    }
    .qr-bank-header i {
    margin-right: 8px;
    color: #1F3061;
}

        .payment-section h3 {
            font-family: Georgia, serif;
            color: #4a2c00;
            font-size: 1rem;
            margin-bottom: 16px;
            border-bottom: 1px solid #f0e8d8;
            padding-bottom: 10px;
        }

    .payment-method-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 16px;
        border: 1.5px solid #f0e8d8;
        border-radius: 8px;
        margin-bottom: 8px;
        transition: all 0.2s;
        background: #fff;
    }

        .payment-method-item:hover {
            border-color: #b8860b;
            background: #fdf6e3;
        }

        .payment-method-item.active {
            border-color: #b8860b;
            background: #fdf6e3;
        }

    .payment-method-logo {
        width: 56px;
        height: 36px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 12px;
        color: #fff;
        flex-shrink: 0;
    }

        .payment-method-logo.vcb {
            background: #006d3c;
        }

        .payment-method-logo.zalopay {
            background: #0068ff;
        }

        .payment-method-logo.cod {
            background: #7c4f00;
        }

    .payment-qr-icon {
        margin-left: auto;
        color: #b8860b;
        font-size: 18px;
        transition: transform 0.25s;
    }

        .payment-qr-icon.open {
            transform: rotate(180deg);
        }

    /* QR INLINE */
    .qr-inline {
        margin-bottom: 12px;
    }

    .qr-inline-box {
        background: #fdf6e3;
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        border: 1.5px solid #f0e8d8;
    }

    .qr-bank-header {
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 16px;
        display: inline-block;
    }

        .qr-bank-header.vcb {
            background: #e8f5e9;
            color: #1b5e20;
        }

        .qr-bank-header.zalo {
            background: #e3f2fd;
            color: #0d47a1;
        }

    .qr-inline-img {
        width: 200px;
        height: 200px;
        object-fit: contain;
        border-radius: 8px;
        border: 2px solid #f0e8d8;
        margin-bottom: 16px;
        display: block;
        margin-left: auto;
        margin-right: auto;
    }

    .qr-info {
        background: #fff;
        border-radius: 8px;
        padding: 12px 16px;
        text-align: left;
        margin-bottom: 12px;
    }

    .qr-info-row {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        padding: 4px 0;
        color: #555;
        border-bottom: 1px solid #f9f4ec;
    }

    .qr-note {
        font-size: 13px;
        color: #888;
    }

    /* ===== COD BOX ===== */
    .cod-box {
        text-align: left;
    }

    .cod-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 16px;
    }

    .cod-icon-circle {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #fff;
        border: 2px solid #ddc590;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .cod-icon-circle i {
            font-size: 22px;
            color: #b8860b;
        }

    .cod-title {
        font-size: 15px;
        font-weight: 700;
        color: #4a2c00;
        margin-bottom: 3px;
    }

    .cod-subtitle {
        font-size: 12px;
        color: #888;
    }

    .cod-steps {
        display: flex;
        flex-direction: column;
        gap: 12px;
        border-top: 1px solid #ddc590;
        padding-top: 16px;
        margin-bottom: 16px;
    }

    .cod-step {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .cod-step-num {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #b8860b;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 13px;
        flex-shrink: 0;
    }

    .cod-step-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding-top: 3px;
    }

        .cod-step-text strong {
            font-size: 13px;
            color: #333;
        }

        .cod-step-text span {
            font-size: 12px;
            color: #888;
        }

    .cod-note {
        background: #fff;
        border: 1px solid #ddc590;
        border-radius: 7px;
        padding: 10px 14px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 12px;
        color: #777;
        line-height: 1.5;
        margin-bottom: 14px;
    }

        .cod-note i {
            color: #b8860b;
            font-size: 15px;
            flex-shrink: 0;
            margin-top: 1px;
        }

    .cod-badge-free {
        display: inline-block;
        background: #e8f5e9;
        color: #2e7d32;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }
</style>

<script>
    function toggleQR(type) {
        const ids = ['vcb', 'zalo', 'cod'];
        ids.forEach(function(id) {
            const box = document.getElementById('qr-' + id);
            const chevron = document.getElementById('chevron-' + id);
            if (id === type) {
                const isOpen = box.style.display !== 'none';
                box.style.display = isOpen ? 'none' : 'block';
                if (chevron) {
                    chevron.classList.toggle('open', !isOpen);
                }
            } else {
                box.style.display = 'none';
                if (chevron) chevron.classList.remove('open');
            }
        });
    }
</script>
