@model QuanLySach.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["HideFooter"] = true;
}

<style>
    .reg-page {
        background: #fdf6ec;
        min-height: calc(100vh - 240px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 16px;
    }

    .reg-wrap {
        display: flex;
        width: 100%;
        max-width: 880px;
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 50px rgba(120, 75, 10, 0.14);
    }

    .reg-form-side {
        flex: 1 1 440px;
        padding: 52px 48px 48px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .reg-title {
        font-family: 'Georgia', 'Times New Roman', serif;
        font-size: 30px;
        font-weight: 700;
        color: #4a2c00;
        margin: 0 0 6px;
        letter-spacing: -0.3px;
    }

    .reg-subtitle {
        font-size: 14px;
        color: #9a7040;
        margin: 0 0 32px;
    }

    .reg-group {
        margin-bottom: 18px;
    }

    .reg-label {
        display: block;
        font-size: 13.5px;
        font-weight: 600;
        color: #4a2c00;
        margin-bottom: 6px;
        letter-spacing: 0.1px;
    }

    .reg-input {
        width: 100%;
        height: 44px;
        padding: 0 14px;
        border: 1.5px solid #ddc590;
        border-radius: 8px;
        font-size: 14px;
        color: #3a2000;
        background: #fffdf8;
        outline: none;
        box-sizing: border-box;
        transition: border-color 0.18s, box-shadow 0.18s, background 0.18s;
        font-family: inherit;
    }

    .reg-input::placeholder {
        color: #c4a46e;
        font-weight: 400;
    }

    .reg-input:hover {
        border-color: #c49a30;
        background: #fffef9;
    }

    .reg-input:focus {
        border-color: #b8860b;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(184, 134, 11, 0.13);
    }

    .reg-input.input-error {
        border-color: #e05555;
        background: #fff8f8;
    }

    .reg-input.input-error:focus {
        border-color: #c0392b;
        box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.12);
    }

    .reg-pw-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

    .reg-pw-wrap .reg-input {
        padding-right: 46px;
    }

    .reg-pw-toggle {
        position: absolute;
        right: 0;
        top: 0;
        width: 44px;
        height: 44px;
        background: none;
        border: none;
        cursor: pointer;
        color: #b09050;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.18s;
        padding: 0;
    }

    .reg-pw-toggle:hover {
        color: #4a2c00;
    }

    .reg-error {
        display: block;
        font-size: 12px;
        color: #c0392b;
        margin-top: 4px;
        min-height: 16px;
    }

    .reg-alert {
        background: #fff0f0;
        border: 1px solid #f5c6c6;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        color: #c0392b;
        margin-bottom: 18px;
    }

    .reg-btn {
        display: block;
        width: 100%;
        height: 48px;
        background: #b8860b;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.4px;
        cursor: pointer;
        margin-top: 26px;
        margin-bottom: 18px;
        transition: background 0.2s, transform 0.12s, box-shadow 0.2s;
        box-shadow: 0 3px 14px rgba(160, 110, 10, 0.28);
        font-family: inherit;
    }

    .reg-btn:hover {
        background: #9a7009;
        box-shadow: 0 5px 20px rgba(130, 90, 8, 0.38);
        transform: translateY(-1px);
    }

    .reg-btn:active {
        transform: translateY(0);
        box-shadow: 0 2px 8px rgba(130, 90, 8, 0.22);
    }

    .reg-login-row {
        text-align: center;
        font-size: 14px;
        color: #7a6040;
        margin: 0;
    }

    .reg-login-row a {
        color: #b8860b;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.18s;
    }

    .reg-login-row a:hover {
        color: #7a5508;
        text-decoration: underline;
    }

    .reg-img-side {
        flex: 1 1 360px;
        position: relative;
        min-height: 520px;
        background: #c8a050;
        overflow: hidden;
    }

    .reg-img-side::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
            160deg,
            rgba(60, 35, 0, 0.55) 0%,
            rgba(180, 130, 10, 0.30) 60%,
            rgba(100, 65, 0, 0.58) 100%
        );
        z-index: 1;
    }

    .reg-img-content {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 36px 32px;
        z-index: 2;
    }

    .reg-img-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .reg-img-logo-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: 2px solid rgba(255, 220, 140, 0.7);
        background: rgba(255, 200, 80, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffe082;
        flex-shrink: 0;
    }

    .reg-img-logo-text strong {
        display: block;
        font-family: 'Georgia', serif;
        font-size: 18px;
        font-weight: 700;
        line-height: 1.2;
        color: #ffe082;
        text-shadow: 0 1px 6px rgba(0,0,0,0.3);
    }

    .reg-img-logo-text span {
        font-size: 12px;
        font-style: italic;
        color: rgba(255, 230, 170, 0.85);
    }

    .reg-img-divider {
        width: 40px;
        height: 2px;
        background: rgba(255, 220, 120, 0.5);
        border-radius: 2px;
        margin-bottom: 14px;
    }

    .reg-img-quote {
        font-family: 'Georgia', 'Times New Roman', serif;
        font-size: 17px;
        line-height: 1.55;
        color: #fff;
        font-style: italic;
        text-shadow: 0 2px 10px rgba(0,0,0,0.3);
        margin: 0;
    }

    .reg-img-quote .qmark {
        font-size: 44px;
        line-height: 0.6;
        display: block;
        margin-bottom: 6px;
        color: #ffe082;
        opacity: 0.85;
    }

    @@media (max-width: 720px) {
        .reg-img-side { display: none; }
        .reg-form-side { padding: 40px 28px 36px; }
        .reg-wrap { border-radius: 14px; }
    }

    @@media (max-width: 480px) {
        .reg-form-side { padding: 32px 20px 28px; }
        .reg-title { font-size: 26px; }
    }
</style>

<div class="reg-page">
    <div class="reg-wrap">

        <!-- LEFT: Form -->
        <div class="reg-form-side">
            <h1 class="reg-title">Регистрация</h1>
            <p class="reg-subtitle">Создайте аккаунт в Книжном Рае</p>

            <form asp-action="Register" asp-controller="Account" method="post" novalidate>
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(""))
                {
                    <div class="reg-alert">
                        @foreach (var err in ViewData.ModelState[""].Errors)
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                }

                <!-- Имя -->
                <div class="reg-group">
                    <label class="reg-label" for="Name">Имя</label>
                    <input class="reg-input @(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "input-error" : "")"
                           type="text"
                           id="Name"
                           name="Name"
                           value="@(Model?.Name)"
                           placeholder="Введите ваше имя"
                           autocomplete="given-name" />
                    <span class="reg-error">
                        @(ViewData.ModelState["Name"]?.Errors.FirstOrDefault()?.ErrorMessage)
                    </span>
                </div>

                <!-- E-mail -->
                <div class="reg-group">
                    <label class="reg-label" for="Email">Электронная почта</label>
                    <input class="reg-input @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "input-error" : "")"
                           type="email"
                           id="Email"
                           name="Email"
                           value="@(Model?.Email)"
                           placeholder="Введите ваш e-mail"
                           autocomplete="email" />
                    <span class="reg-error">
                        @(ViewData.ModelState["Email"]?.Errors.FirstOrDefault()?.ErrorMessage)
                    </span>
                </div>

                <!-- Пароль -->
                <div class="reg-group">
                    <label class="reg-label" for="Password">Пароль</label>
                    <div class="reg-pw-wrap">
                        <input class="reg-input @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "input-error" : "")"
                               type="password"
                               id="Password"
                               name="Password"
                               placeholder="Введите пароль"
                               autocomplete="new-password" />
                        <button type="button" class="reg-pw-toggle"
                                onclick="regTogglePw('Password', this)"
                                aria-label="Показать пароль" tabindex="-1">
                            <svg id="eye-Password" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <span class="reg-error">
                        @(ViewData.ModelState["Password"]?.Errors.FirstOrDefault()?.ErrorMessage)
                    </span>
                </div>

                <!-- Подтвердите пароль -->
                <div class="reg-group">
                    <label class="reg-label" for="ConfirmPassword">Подтвердите пароль</label>
                    <div class="reg-pw-wrap">
                        <input class="reg-input @(ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "input-error" : "")"
                               type="password"
                               id="ConfirmPassword"
                               name="ConfirmPassword"
                               placeholder="Повторите пароль"
                               autocomplete="new-password" />
                        <button type="button" class="reg-pw-toggle"
                                onclick="regTogglePw('ConfirmPassword', this)"
                                aria-label="Показать пароль" tabindex="-1">
                            <svg id="eye-ConfirmPassword" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <span class="reg-error">
                        @(ViewData.ModelState["ConfirmPassword"]?.Errors.FirstOrDefault()?.ErrorMessage)
                    </span>
                </div>

                <button type="submit" class="reg-btn">Зарегистрироваться</button>

                <p class="reg-login-row">
                    Уже есть аккаунт? <a asp-action="Login">Войти</a>
                </p>
            </form>
        </div>

        <!-- RIGHT: Decorative panel — dùng hero1.png có sẵn trong project -->
        <div class="reg-img-side"
             style="background-image: url('/images/hero1.png'); background-size: cover; background-position: center;">
            <div class="reg-img-content">
                <div class="reg-img-logo">
                    <div class="reg-img-logo-circle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                        </svg>
                    </div>
                    <div class="reg-img-logo-text">
                        <strong>Книжный Рай</strong>
                        <span>— Книжный рай —</span>
                    </div>
                </div>
                <div class="reg-img-divider"></div>
                <p class="reg-img-quote">
                    <span class="qmark">"</span>
                    Место, где живут книги<br />и рождаются мечты
                </p>
            </div>
        </div>

    </div>
</div>

<script>
    function regTogglePw(fieldId, btn) {
        var input = document.getElementById(fieldId);
        var svg = document.getElementById('eye-' + fieldId);
        if (input.type === 'password') {
            input.type = 'text';
            btn.setAttribute('aria-label', 'Скрыть пароль');
            svg.innerHTML =
                '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>' +
                '<path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>' +
                '<line x1="1" y1="1" x2="23" y2="23"/>';
        } else {
            input.type = 'password';
            btn.setAttribute('aria-label', 'Показать пароль');
            svg.innerHTML =
                '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>' +
                '<circle cx="12" cy="12" r="3"/>';
        }
    }
</script>
