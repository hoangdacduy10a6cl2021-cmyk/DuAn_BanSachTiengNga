@model IEnumerable<QuanLySach.Models.CartItem>
@{
    ViewData["Title"] = "Оформление заказа";
    var total = Model.Sum(i => i.Book!.Price * i.Quantity);
}

<div class="checkout-page">
    <h2 class="checkout-title">Оформление заказа</h2>

    <form id="orderForm" asp-action="PlaceOrder" method="post">
        <input type="hidden" name="paymentMethod" id="paymentMethodInput" value="Наличными" />

        <div class="checkout-layout">
            <!-- CỘT TRÁI -->
            <div class="checkout-left">
                <div class="checkout-box">
                    <h3>Контактные данные</h3>
                    <div class="form-group">
                        <label>Имя</label>
                        <input type="text" name="name" placeholder="Введите ваше имя" required />
                    </div>
                    <div class="form-group">
                        <label>E-mail</label>
                        <input type="email" name="email" placeholder="Введите ваш e-mail" required />
                    </div>
                    <div class="form-group">
                        <label>Телефон</label>
                        <input type="text" name="phone" placeholder="Введите ваш телефон" />
                    </div>

                    <h3 style="margin-top:20px">Способ доставки</h3>
                    <label class="delivery-option">
                        <input type="radio" name="deliveryMethod" value="Курьером" checked />
                        <span>Курьером — Бесплатно — Доставка 1-3 дня</span>
                    </label>
                    <label class="delivery-option">
                        <input type="radio" name="deliveryMethod" value="Почтой России" />
                        <span>Почтой России — Бесплатно — Доставка 5-7 дней</span>
                    </label>

                    <h3 style="margin-top:20px">Способ оплаты</h3>

                    <!-- RADIO CHỌN -->
                    <label class="delivery-option" onclick="selectPayment('cash')">
                        <input type="radio" name="paymentChoice" value="cash" checked />
                        <span>💵 Наличными при получении — <strong style="color:#2e7d32">Бесплатно</strong></span>
                    </label>
                    <label class="delivery-option" onclick="selectPayment('qr')">
                        <input type="radio" name="paymentChoice" value="qr" />
                        <span>📱 Оплата по QR-коду (Vietcombank / ZaloPay)</span>
                    </label>

                    <!-- ===== CASH INFO (MỚI ĐẸP HƠN) ===== -->
                    <div id="cash-info" class="cash-info-box">
                        <!-- Header -->
                        <div class="cash-info-header">
                            <div class="cash-icon-circle">
                                <i class="fas fa-money-bill-wave"></i>
                            </div>
                            <div>
                                <div class="cash-info-title">Оплата при получении</div>
                                <div class="cash-info-subtitle">Без предоплаты — платите только при получении</div>
                            </div>
                        </div>

                        <!-- Các bước -->
                        <div class="cash-steps">
                            <div class="cash-step">
                                <span class="step-num">1</span>
                                <div class="step-text">
                                    <strong>Оформите заказ</strong>
                                    <span>Выберите книги и укажите адрес доставки</span>
                                </div>
                            </div>
                            <div class="cash-step">
                                <span class="step-num">2</span>
                                <div class="step-text">
                                    <strong>Подтверждение магазина</strong>
                                    <span>Мы свяжемся с вами для подтверждения</span>
                                </div>
                            </div>
                            <div class="cash-step">
                                <span class="step-num">3</span>
                                <div class="step-text">
                                    <strong>Ожидайте курьера</strong>
                                    <span>Курьер свяжется с вами перед приездом</span>
                                </div>
                            </div>
                            <div class="cash-step">
                                <span class="step-num">4</span>
                                <div class="step-text">
                                    <strong>Проверьте и оплатите</strong>
                                    <span>Осмотрите заказ и передайте деньги курьеру</span>
                                </div>
                            </div>
                        </div>

                        <!-- Ghi chú -->
                        <div class="cash-note">
                            <i class="fas fa-info-circle"></i>
                            <span>Доступно только для доставки по России. Дополнительная комиссия не взимается.</span>
                        </div>

                        <span class="badge-free">✓ Бесплатно</span>
                    </div>

                </div>
            </div>

            <!-- CỘT GIỮA -->
            <div class="checkout-mid">
                <div class="checkout-box">
                    <h3>Адрес доставки</h3>
                    <div class="form-group">
                        <label>Город</label>
                        <input type="text" name="city" placeholder="Введите город" required />
                    </div>
                    <div class="form-group">
                        <label>Улица</label>
                        <input type="text" name="street" placeholder="Введите улицу" />
                    </div>
                    <div class="form-group">
                        <label>Дом</label>
                        <input type="text" name="house" placeholder="Введите дом" />
                    </div>
                    <div class="form-group">
                        <label>Квартира</label>
                        <input type="text" name="apartment" placeholder="Введите квартиру" />
                    </div>
                    <div class="form-group">
                        <label>Индекс</label>
                        <input type="text" name="postalCode" placeholder="Введите индекс" />
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI -->
            <div class="checkout-right">
                <div class="checkout-box">
                    <h3>Ваш заказ</h3>
                    @foreach (var item in Model)
                    {
                        <div class="order-line">
                            <span>@item.Book?.Title</span>
                            <span>@item.Book?.Price.ToString("0.00") ₽ × @item.Quantity</span>
                        </div>
                    }
                    <div class="order-line">
                        <span>Доставка:</span>
                        <span style="color:#2e7d32">Бесплатно</span>
                    </div>
                    <div class="order-total">
                        <span>Итого:</span>
                        <span>@total.ToString("0.00") ₽</span>
                    </div>
                    <button type="button" onclick="handleOrder()" class="btn-place-order">
                        Подтвердить заказ
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- POPUP QR -->
<div id="qr-modal" class="qr-modal" style="display:none">
    <div class="qr-modal-box">
        <button class="qr-close" onclick="closeQR()">✕</button>
        <h2 class="qr-modal-title">Оплата по QR-коду</h2>
        <p class="qr-modal-sub">Отсканируйте код в приложении банка</p>

        <div class="qr-tabs">
            <button class="qr-tab active" onclick="switchQR('vcb', this)">🏦 Vietcombank</button>
            <button class="qr-tab" onclick="switchQR('zalo', this)">💚 ZaloPay</button>
        </div>

        <!-- VCB -->
        <div id="qr-vcb" class="qr-content">
            <div class="qr-bank-header vcb">
                <span>🏦 Ngân hàng Vietcombank</span>
            </div>
            <img src="https://img.vietqr.io/image/vietcombank-1035382800-compact2.jpg?amount=@((int)total)&addInfo=ThanhToanDonHang&accountName=PHAM+DUC+HOA"
                 alt="QR Vietcombank" class="qr-image" />
            <div class="qr-info">
                <div class="qr-info-row">
                    <span>Счёт:</span>
                    <strong>1035382800</strong>
                </div>
                <div class="qr-info-row">
                    <span>Владелец:</span>
                    <strong>PHAM DUC HOA</strong>
                </div>
                <div class="qr-info-row">
                    <span>Сумма:</span>
                    <strong style="color:#b8860b">@total.ToString("0.00") ₽</strong>
                </div>
            </div>
        </div>

        <!-- ZALOPAY -->
        <div id="qr-zalo" class="qr-content" style="display:none">
            <div class="qr-bank-header zalo">
                <span>💚 ZaloPay — PHAM DUC HOA</span>
            </div>
            <img src="/images/zalopay-qr.png" alt="QR ZaloPay" class="qr-image" />
            <div class="qr-info">
                <div class="qr-info-row">
                    <span>Владелец:</span>
                    <strong>PHAM DUC HOA</strong>
                </div>
                <div class="qr-info-row">
                    <span>Сумма:</span>
                    <strong style="color:#b8860b">@total.ToString("0.00") ₽</strong>
                </div>
            </div>
        </div>

        <p class="qr-guide">
            📌 После оплаты нажмите кнопку ниже для подтверждения
        </p>
        <button class="btn-paid" onclick="confirmQRPayment()">
            ✅ Я оплатил — Подтвердить заказ
        </button>
    </div>
</div>
<div id="qr-overlay" class="qr-overlay" style="display:none" onclick="closeQR()"></div>

<style>
    .checkout-page {
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .checkout-title {
        font-family: Georgia, serif;
        font-size: 2rem;
        color: #4a2c00;
        margin-bottom: 30px;
    }

    .checkout-layout {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 24px;
    }

    .checkout-box {
        background: #fff;
        border-radius: 8px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

        .checkout-box h3 {
            font-family: Georgia, serif;
            color: #4a2c00;
            font-size: 1rem;
            margin-bottom: 16px;
        }

    .form-group {
        margin-bottom: 14px;
    }

        .form-group label {
            display: block;
            font-size: 13px;
            color: #666;
            margin-bottom: 4px;
        }

        .form-group input {
            width: 100%;
            padding: 10px 14px;
            border: 1.5px solid #ddc590;
            border-radius: 6px;
            font-size: 14px;
            outline: none;
            box-sizing: border-box;
        }

            .form-group input:focus {
                border-color: #b8860b;
            }

    .delivery-option {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 12px;
        font-size: 13px;
        color: #555;
        cursor: pointer;
    }

        .delivery-option input {
            margin-top: 3px;
            accent-color: #b8860b;
        }

    /* ===== CASH INFO BOX ===== */
    .cash-info-box {
        margin-top: 16px;
        background: #fdf6e3;
        border: 1.5px solid #ddc590;
        border-radius: 10px;
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .cash-info-header {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .cash-icon-circle {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #fff;
        border: 2px solid #ddc590;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .cash-icon-circle i {
            font-size: 22px;
            color: #b8860b;
        }

    .cash-info-title {
        font-size: 14px;
        font-weight: 700;
        color: #4a2c00;
        margin-bottom: 3px;
    }

    .cash-info-subtitle {
        font-size: 12px;
        color: #888;
    }

    .cash-steps {
        display: flex;
        flex-direction: column;
        gap: 10px;
        border-top: 1px solid #ddc590;
        padding-top: 14px;
    }

    .cash-step {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .step-num {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #b8860b;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 13px;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .step-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

        .step-text strong {
            font-size: 13px;
            color: #333;
        }

        .step-text span {
            font-size: 12px;
            color: #888;
        }

    .cash-note {
        background: #fff;
        border: 1px solid #ddc590;
        border-radius: 7px;
        padding: 10px 14px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 12px;
        color: #777;
        line-height: 1.5;
    }

        .cash-note i {
            color: #b8860b;
            font-size: 15px;
            flex-shrink: 0;
            margin-top: 1px;
        }

    .badge-free {
        display: inline-block;
        background: #e8f5e9;
        color: #2e7d32;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        align-self: flex-start;
    }

    /* ORDER */
    .order-line {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        color: #555;
        margin-bottom: 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid #f0e8d8;
    }

    .order-total {
        display: flex;
        justify-content: space-between;
        font-size: 1.1rem;
        font-weight: bold;
        color: #333;
        margin: 16px 0;
    }

    .btn-place-order {
        width: 100%;
        background: #b8860b;
        color: #fff;
        border: none;
        padding: 14px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-place-order:hover {
            background: #9a6f00;
        }

    /* QR MODAL */
    .qr-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
    }

    .qr-modal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1001;
        width: 100%;
        max-width: 420px;
    }

    .qr-modal-box {
        background: #fff;
        border-radius: 16px;
        padding: 32px 24px;
        text-align: center;
        position: relative;
        max-height: 90vh;
        overflow-y: auto;
    }

    .qr-close {
        position: absolute;
        top: 12px;
        right: 16px;
        background: none;
        border: none;
        font-size: 20px;
        cursor: pointer;
        color: #999;
    }

    .qr-modal-title {
        font-family: Georgia, serif;
        font-size: 1.4rem;
        color: #4a2c00;
        margin-bottom: 6px;
    }

    .qr-modal-sub {
        font-size: 13px;
        color: #888;
        margin-bottom: 20px;
    }

    .qr-tabs {
        display: flex;
        gap: 8px;
        justify-content: center;
        margin-bottom: 20px;
    }

    .qr-tab {
        padding: 8px 20px;
        border-radius: 20px;
        border: 2px solid #ddd;
        background: #fff;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        color: #666;
        transition: all 0.2s;
    }

        .qr-tab.active {
            border-color: #b8860b;
            color: #b8860b;
            background: #fdf6e3;
        }

    .qr-bank-header {
        padding: 10px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 16px;
    }

        .qr-bank-header.vcb {
            background: #e8f5e9;
            color: #1b5e20;
        }

        .qr-bank-header.zalo {
            background: #e8f5e9;
            color: #1b5e20;
        }

    .qr-image {
        width: 200px;
        height: 200px;
        object-fit: contain;
        border-radius: 8px;
        border: 2px solid #f0e8d8;
        margin-bottom: 16px;
    }

    .qr-info {
        background: #fdf6e3;
        border-radius: 8px;
        padding: 12px 16px;
        text-align: left;
        margin-bottom: 16px;
    }

    .qr-info-row {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        padding: 4px 0;
        color: #555;
    }

    .qr-guide {
        font-size: 13px;
        color: #888;
        margin-bottom: 16px;
    }

    .btn-paid {
        width: 100%;
        background: #2e7d32;
        color: #fff;
        border: none;
        padding: 14px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-paid:hover {
            background: #1b5e20;
        }

    @@media (max-width: 768px) {
        .checkout-layout {
            grid-template-columns: 1fr;
        }

        .qr-modal {
            padding: 0 12px;
        }
    }
</style>

<script>
    function selectPayment(type) {
        const cashInfo = document.getElementById('cash-info');
        cashInfo.style.display = type === 'cash' ? 'flex' : 'none';
        document.getElementById('paymentMethodInput').value = type === 'cash' ? 'Наличными' : 'QR-код';
    }

    function handleOrder() {
        const paymentChoice = document.querySelector('input[name="paymentChoice"]:checked').value;
        if (paymentChoice === 'qr') {
            document.getElementById('qr-modal').style.display = 'block';
            document.getElementById('qr-overlay').style.display = 'block';
        } else {
            document.getElementById('orderForm').submit();
        }
    }

    function closeQR() {
        document.getElementById('qr-modal').style.display = 'none';
        document.getElementById('qr-overlay').style.display = 'none';
    }

    function confirmQRPayment() {
        document.getElementById('paymentMethodInput').value = 'QR-код';
        closeQR();
        document.getElementById('orderForm').submit();
    }

    function switchQR(type, btn) {
        document.querySelectorAll('.qr-content').forEach(el => el.style.display = 'none');
        document.querySelectorAll('.qr-tab').forEach(b => b.classList.remove('active'));
        document.getElementById('qr-' + type).style.display = 'block';
        btn.classList.add('active');
    }
</script>
